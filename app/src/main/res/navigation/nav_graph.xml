<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.gestura.auth.LoginFragment"
        tools:layout="@layout/fragment_login">

        <!-- NEW: action to your home screen -->
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/aslFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/translationFragment"
        android:name="com.example.gestura.TranslationFragment"
        android:label="Translate" />

    <fragment
        android:id="@+id/avatarFragment"
        android:name="com.example.gestura.AvatarFragment"
        android:label="Avatar" />

    <fragment
        android:id="@+id/aslFragment"
        android:name="com.example.gestura.ui.OnDeviceCaptionFragment"
        android:label="ASL"
        tools:layout="@layout/fragment_compose_host" />

    <fragment
        android:id="@+id/contributeFragment"
        android:name="com.example.gestura.ContributeFragment"
        android:label="Contribute" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.gestura.settings.SettingsFragment"
        android:label="Settings" />
    <fragment
        android:id="@+id/devReviewFragment"
        android:name="com.example.gestura.dev.DevReviewFragment"
        android:label="Developer tools" />

</navigation>
